# Public site key may appear in client config.
TURNSTILE_SITE_KEY=your-public-site-key
# Configure the following as Cloudflare encrypted Secrets, never commit actual values.
TURNSTILE_SECRET=REPLACE_LOCALLY_NOT_A_SECRET
SESSION_SECRET=REPLACE_LOCALLY_WITH_32_PLUS_RANDOM_CHARS
SYNC_SECRET=REPLACE_LOCALLY_WITH_ANOTHER_32_PLUS_RANDOM_CHARS
